# Copier ce fichier en .env.local puis remplacer les valeurs.
# .env.local n'est jamais envoyé sur internet ni dans git (ignoré volontairement).

# URL de l'API Nigel. En local (les deux tournent sur la même machine),
# souvent http://localhost:8000. Pour un accès distant réel (Vercel, ou un
# appareil hors du réseau local), l'adresse HTTPS Tailscale de la machine
# qui héberge Nigel - voir Projet - Assistant IA (Nigel)/README.md
# "API (pour Le Domaine)".
NEXT_PUBLIC_API_URL=http://localhost:8000

# Authentification : même projet Supabase que Ménage (voir Projet - Taches
# ménage/Application Tâches ménagères/web) - connexion par code à 6
# chiffres envoyé par email, pas de mot de passe. URL et clé publique
# (anon) du projet, visibles dans Project Settings > API sur Supabase -
# la clé anon est publique par nature (protégée par RLS côté base), pas un
# secret à cacher comme la clé secrète utilisée par Nigel.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
